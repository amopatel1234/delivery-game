# Fastlane configuration for Couriers Gambit (delivery-game).
# Docs: https://docs.fastlane.tools
# ASC API: https://docs.fastlane.tools/app-store-connect-api/

default_platform(:ios)

platform :ios do
  PROJECT_NAME = "delivery-game.xcodeproj"
  APP_IDENTIFIER = "com.amishpatel.couriesgambit.game"
  APP_TARGET = "delivery-game"
  UNIT_TEST_TARGET = "delivery-gameTests"
  PROVISIONING_PROFILE_NAME = "Couriers Gambit App Store Profile"
  TEAM_ID = "24CTGGM78R"
  PINNED_TEST_DESTINATION = "platform=iOS Simulator,name=iPhone 17 Pro"

  desc "Run unit tests only (no UI tests) on the pinned iPhone 17 Pro simulator"
  lane :runUnitTests do
    required_vars = ["PROJECT_FILENAME", "SCHEME"]
    required_vars.each do |var|
      UI.user_error!("Missing required environment variable: #{var}") unless ENV[var]
    end

    run_tests(
      project: ENV["PROJECT_FILENAME"],
      scheme: ENV["SCHEME"],
      destination: PINNED_TEST_DESTINATION,
      only_testing: [UNIT_TEST_TARGET],
      ensure_devices_found: true,
      result_bundle: true,
    )
  end

  desc "Build and upload to TestFlight (no App Store submission)"
  lane :deploy do
    marketing_version = get_version_number(
      xcodeproj: PROJECT_NAME,
      target: APP_TARGET
    )

    UI.message("App Store marketing version (from Xcode): #{marketing_version}")

    # Official App Store Connect API env vars (preferred):
    #   APP_STORE_CONNECT_API_KEY_KEY_ID
    #   APP_STORE_CONNECT_API_KEY_ISSUER_ID
    #   APP_STORE_CONNECT_API_KEY_KEY
    #   APP_STORE_CONNECT_API_KEY_IS_KEY_CONTENT_BASE64 (optional)
    #   APP_STORE_CONNECT_API_KEY_IN_HOUSE (optional; required for sigh/match clarity)
    # Legacy aliases also accepted: KEY_ID, ISSUER_ID, KEY_VALUE
    key_id = ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"] || ENV["KEY_ID"]
    issuer_id = ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"] || ENV["ISSUER_ID"]
    key_content = ENV["APP_STORE_CONNECT_API_KEY_KEY"] || ENV["KEY_VALUE"]
    UI.user_error!("Missing App Store Connect API key id") if key_id.to_s.empty?
    UI.user_error!("Missing App Store Connect API issuer id") if issuer_id.to_s.empty?
    UI.user_error!("Missing App Store Connect API key content") if key_content.to_s.empty?

    is_base64 = ENV.fetch("APP_STORE_CONNECT_API_KEY_IS_KEY_CONTENT_BASE64", "false") == "true"
    in_house = ENV.fetch("APP_STORE_CONNECT_API_KEY_IN_HOUSE", "false") == "true"

    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_content,
      is_key_content_base64: is_base64,
      duration: 1200,
      in_house: in_house # false for App Store teams; needed for sigh clarity
    )

    password = SecureRandom.hex
    keychain_name = "signing_temp"

    create_keychain(
      name: keychain_name,
      password: password,
      unlock: true,
      timeout: 0,
      lock_when_sleeps: true
    )

    begin
      import_certificate(
        certificate_path: "distribution.p12",
        certificate_password: ENV["CERTIFICATE_PASSWORD"],
        keychain_password: password,
        keychain_name: keychain_name
      )

      begin
        latest_build = latest_testflight_build_number(
          app_identifier: APP_IDENTIFIER,
          version: marketing_version,
          team_id: TEAM_ID
        )
        build_number = latest_build + 1
      rescue => e
        UI.important("No TestFlight builds found for #{marketing_version}: #{e.message}")
        build_number = 1
      end

      increment_build_number(
        build_number: build_number,
        xcodeproj: PROJECT_NAME
      )

      UI.message("Build number for #{marketing_version}: #{build_number}")

      get_provisioning_profile(
        readonly: true,
        app_identifier: APP_IDENTIFIER,
        provisioning_name: PROVISIONING_PROFILE_NAME,
        team_id: TEAM_ID
      )

      update_code_signing_settings(
        use_automatic_signing: false,
        code_sign_identity: "Apple Distribution",
        profile_name: PROVISIONING_PROFILE_NAME,
        team_id: TEAM_ID,
        targets: APP_TARGET
      )

      ipa_path = gym(
        project: PROJECT_NAME,
        scheme: APP_TARGET,
        export_method: "app-store",
        destination: "generic/platform=iOS",
        sdk: "iphoneos",
        export_team_id: TEAM_ID
      )

      UI.success("Built IPA at: #{ipa_path}")

      testing_notes_path = File.join(__dir__, "testing_notes.txt")
      UI.user_error!("Missing #{testing_notes_path} — add What to Test notes before deploy") unless File.exist?(testing_notes_path)
      testing_notes = File.read(testing_notes_path).strip
      UI.user_error!("fastlane/testing_notes.txt is empty — add a short What to Test sentence before deploy") if testing_notes.empty?
      UI.message("TestFlight What to Test notes:\n#{testing_notes}")

      upload_to_testflight(
        app_platform: "ios",
        changelog: testing_notes,
        team_id: TEAM_ID,
        # Matches INFOPLIST_KEY_ITSAppUsesNonExemptEncryption = NO in the app target.
        uses_non_exempt_encryption: false,
        # Upload + wait for processing/changelog only. Do not pass `groups:` —
        # ASC rejects API assignment to the Internal group ("Cannot add internal
        # group to a build"). Enable Automatic distribution on Internal in ASC.
        skip_waiting_for_build_processing: false
      )
    ensure
      delete_keychain(name: keychain_name)
    end
  end
end
